{
  description = "dtr — a serial-first terminal";

  inputs.nixpkgs.url = "https://channels.nixos.org/nixos-unstable/nixexprs.tar.zst";
  inputs.rust-overlay = {
    url = "github:oxalica/rust-overlay";
    inputs.nixpkgs.follows = "nixpkgs";
  };
  # crane splits the build in two: dependencies compile once into
  # `cargoArtifacts`, and a source-only change recompiles just our crates.
  # With buildRustPackage every edit rebuilt the whole dependency graph, which
  # is minutes of waiting per keystroke-sized change.
  inputs.crane.url = "github:ipetkov/crane";

  outputs = {
    self,
    nixpkgs,
    rust-overlay,
    crane,
  }: let
    system = "x86_64-linux";
    pkgs = import nixpkgs {
      inherit system;
      overlays = [rust-overlay.overlays.default];
    };
    inherit (pkgs) lib;

    # The commit libghostty-vt-sys' bindings were generated against — the
    # `GHOSTTY_COMMIT` in libghostty-rs' build.rs at the revision Cargo.toml
    # pins. Do not float: the generated FFI is ABI-specific to this revision.
    #
    # 0b8b998 (2026-10-28) is the last commit before libghostty-vt's pre-1.0
    # ABI freeze, and it is what the bindings can actually drive. It carries
    # the two libghostty-vt security fixes our previous pin (521cf2c) lacked:
    # GHSA-w9q4-5jvv-mcv4 (memory corruption when a scroll-clear prunes the
    # cursor page) and GHSA-jqr7-69mm-v35h (crash narrowing a very wide page),
    # both fixed 2026-10-26. Upstream has since tagged `vt-1.0.0`, but the
    # headers changed +3926/−3638 lines in between and the bindings have not
    # regenerated against them yet; moving here is what is reachable today.
    ghostty = pkgs.fetchFromGitHub {
      owner = "ghostty-org";
      repo = "ghostty";
      rev = "0b8b9984ee560456194262d190aa850224edb1f4";
      hash = "sha256-z2zMMVi6o7rGY72pJGA/SRuR5d1rSBUEscn6G1nlHzk=";
    };

    # Upstream's own derivation: builds via `zig build -Demit-lib-vt=true`
    # with an offline package cache generated by zon2nix.
    libghostty-vt = pkgs.callPackage (ghostty + "/nix/libghostty-vt.nix") {
      revision = "0b8b998";
      # Upstream's derivation defaults to a **Debug** Zig build, which is what
      # the flake was shipping: 4 MB of terminal output cost 7 s of CPU, and a
      # profile of `ls` was 24% page-integrity assertions. ReleaseFast is what
      # ghostty itself ships.
      optimize = "ReleaseFast";
    };

    # Windows: zig names the archive `ghostty-vt-static.lib` and the generated
    # .pc points at $out, so keep everything in one output and skip upstream's
    # move-to-dev steps (they assume an ELF `libghostty-vt.a`).
    libghostty-vt-win = libghostty-vt.overrideAttrs (old: {
      pname = "libghostty-vt-win";
      outputs = ["out"];
      zigBuildFlags = old.zigBuildFlags ++ ["-Dtarget=x86_64-windows-gnu"];
      postInstall = "";
      postFixup = "";
    });

    # Only source files; keeps target/ and results out of the store. `assets` is
    # source too: the window icon and the desktop entry's artwork are compiled
    # into the binary, so a build without them does not compile.
    src = lib.fileset.toSource {
      root = ./.;
      fileset = lib.fileset.unions [
        ./Cargo.toml
        ./Cargo.lock
        ./crates
        ./assets
      ];
    };

    # The version is Cargo's, and only Cargo's. The manifest is imported so the
    # package, the Windows exe and the release tag cannot disagree; `just
    # release X.Y.Z` is the one thing that edits it, and the release workflow
    # refuses a tag that does not match.
    version = (lib.importTOML ./Cargo.toml).workspace.package.version;

    rustHost = pkgs.rust-bin.stable.latest.default;

    # Fonts a machine needs to lay out text: a monospaced Latin face for the
    # grid, and a CJK face for the fallback the terminal installs at startup so
    # that Han and kana are not egui's missing-glyph box. A developer's machine
    # has these in /usr/share/fonts; a devShell and a CI runner do not.
    fontPackages = with pkgs; [dejavu_fonts noto-fonts-cjk-sans];

    # `FONTCONFIG_FILE` is read before fontconfig's compiled-in default, which is
    # what a devShell without /etc/fonts needs. The stock `conf.d` is included on
    # purpose: it is where `monospace` and `sans-serif` are aliased to real
    # families, and without those aliases asking for `monospace` matches nothing.
    fontsConf = pkgs.writeText "dtr-fonts.conf" ''
      <?xml version="1.0"?>
      <fontconfig>
        <include ignore_missing="yes">${pkgs.fontconfig}/etc/fonts/conf.d</include>
        ${lib.concatMapStrings (package: "<dir>${package}</dir>\n") fontPackages}
        <cachedir>/tmp/dtr-fonts-cache</cachedir>
      </fontconfig>
    '';
    craneLib = (crane.mkLib pkgs).overrideToolchain rustHost;

    # Everything the two halves of the build agree on. `cargoArtifacts` is
    # keyed on the *dependencies*, so editing `crates/dtr` reuses the compiled
    # graph and only recompiles the crates that changed.
    cargoCommon = {
      inherit src;
      pname = "dtr";
      inherit version;
      strictDeps = true;
      buildInputs = [
        pkgs.udev
        pkgs.fontconfig
        pkgs.freetype
        libghostty-vt.dev
        pkgs.vulkan-loader
        pkgs.libxkbcommon
        pkgs.wayland
        pkgs.libX11
        pkgs.libxcb
        pkgs.libXcursor
        pkgs.libXi
        pkgs.libXrandr
      ];
      nativeBuildInputs = [pkgs.pkg-config pkgs.makeWrapper];
      # serialport enumerates through libudev, whose .pc lives in its dev output.
      PKG_CONFIG_PATH = lib.makeSearchPath "share/pkgconfig" [libghostty-vt.dev]
        + ":" + lib.makeSearchPath "lib/pkgconfig" [pkgs.udev.dev pkgs.fontconfig.dev pkgs.freetype.dev];
      # Vendored once, shared by the dependency build and the package build.
      # crane fetches the git dependency at the revision Cargo.lock pins; that
      # revision, not a store hash, is what makes it reproducible here — crane
      # keys output hashes by lock source, so importCargoLock's crate-keyed
      # verification cannot be reused with it.
      cargoVendorDir = craneLib.vendorCargoDeps {
        inherit src;
      };
    };

    # Built once per dependency set; this is the half that used to run on every
    # edit. `cargoArtifacts` is a plain derivation, so it caches in the store and
    # in the binary cache like anything else.
    dtrDeps = craneLib.buildDepsOnly (cargoCommon // {pname = "dtr-deps";});

    dtr = craneLib.buildPackage (cargoCommon
      // {
        cargoArtifacts = dtrDeps;
        # Tests are their own check: `nix build .#dtr` is what you run twenty
        # times an hour, and it should not wait for the whole suite.
        doCheck = false;

        # winit and wgpu-hal resolve these with dlopen, so they never appear as
        # DT_NEEDED entries and no rpath can reach them. A wrapper is the only
        # thing that works for dlopened libraries.
        postInstall = ''
          mv $out/bin/dtr $out/bin/.dtr-unwrapped
          makeWrapper $out/bin/.dtr-unwrapped $out/bin/dtr \
            --prefix LD_LIBRARY_PATH : ${lib.makeLibraryPath (with pkgs; [
          wayland
          libxkbcommon
          vulkan-loader
          libGL
          libX11
          libxcb
          libXcursor
          libXi
          libXrandr
        ])} \
            --suffix LD_LIBRARY_PATH : /run/opengl-driver/lib

          # The desktop entry and the icons it names. `Icon=dtr` is a lookup in
          # the theme, so the files have to land under hicolor as `dtr`; the
          # sizes are the ones the logo set actually has, and the vector one
          # covers everything a bitmap would be stretched for.
          install -Dm644 ${./assets/dtr.desktop} $out/share/applications/dtr.desktop
          install -Dm644 ${./assets/logo/dtr-mark.svg} $out/share/icons/hicolor/scalable/apps/dtr.svg
          install -Dm644 ${./assets/logo/dtr-mark-512.png} $out/share/icons/hicolor/512x512/apps/dtr.png
          install -Dm644 ${./assets/logo/dtr-mark-32.png} $out/share/icons/hicolor/32x32/apps/dtr.png
          install -Dm644 ${./assets/logo/dtr-mark-16.png} $out/share/icons/hicolor/16x16/apps/dtr.png
        '';
      });

    dtr-windows = pkgs.stdenv.mkDerivation {
      pname = "dtr";
      inherit version;
      src = src;
      cargoDeps = pkgs.rustPlatform.importCargoLock {
        lockFile = ./Cargo.lock;
        # Git dependencies need explicit hashes; both crates come from the same
        # checkout, so they share one. Update on wrapper bumps.
        outputHashes = {
          "libghostty-vt-0.2.1" = "sha256-tLVqh8p9H8N54XlmNS3qbQGGRRaSkn04aC93DHAvwak=";
          "libghostty-vt-sys-0.2.1" = "sha256-tLVqh8p9H8N54XlmNS3qbQGGRRaSkn04aC93DHAvwak=";
        };
      };
      nativeBuildInputs = [
        rustWindows
        pkgs.cargo-zigbuild
        pkgs.zig_0_17
        pkgs.pkg-config
        pkgs.rustPlatform.cargoSetupHook
      ];
      buildPhase = ''
        runHook preBuild
        # PKG_CONFIG_PATH wins over LIBDIR, so it must be cleared or the
        # devShell's Linux .pc silently supplies a Linux search path.
        # cargo-zigbuild caches under $HOME; the sandbox HOME is unwritable.
        export HOME=$TMPDIR
        export PKG_CONFIG_ALLOW_CROSS=1
        export PKG_CONFIG_PATH=""
        export PKG_CONFIG_LIBDIR=${libghostty-vt-win}/share/pkgconfig
        # winapi links the `synchronization` API-set import library, which zig's
        # mingw does not ship. Every symbol it uses is already in kernel32, so an
        # empty archive satisfies the search without changing the link.
        mkdir -p api-stubs
        printf '!<arch>\n' > api-stubs/libsynchronization.a
        # zig cc enables -Werror=date-time for reproducibility, and mimalloc
        # mentions __DATE__ in an assert message. Its build script suppresses
        # that warning only for non-Windows targets (it assumes MSVC there, where
        # the flag does not exist). Appending the opposite last is what works.
        export CFLAGS_x86_64_pc_windows_gnu="-Wno-error=date-time"
        export RUSTFLAGS="-Lnative=$PWD/api-stubs"
        cargo zigbuild --offline --locked --release --package dtr \
          --target x86_64-pc-windows-gnu
        runHook postBuild
      '';
      installPhase = ''
        runHook preInstall
        install -Dm755 target/x86_64-pc-windows-gnu/release/dtr.exe "$out/bin/dtr.exe"
        runHook postInstall
      '';
    };

    rustWindows = pkgs.rust-bin.stable.latest.default.override {
      targets = ["x86_64-pc-windows-gnu"];
    };
  in {
    packages.${system} = {
      inherit dtr libghostty-vt libghostty-vt-win;
      windows = dtr-windows;
      default = dtr;
    };

    # `nix flake check` is the one place the gates are written down: CI runs it
    # and adds nothing, so a green run on a laptop means the same thing as a
    # green pipeline. Add a gate here rather than to .gitlab-ci.yml.
    checks.${system} = {
      # The tests render through wgpu and lay out real text, and the sandbox has
      # neither a GPU nor /usr/share/fonts. The same software paths the devShell
      # picks for a machine with no /dev/dri are selected here, so `nix flake
      # check` runs the real suite rather than nine failures about adapters.
      tests = craneLib.cargoTest (cargoCommon
        // {
          cargoArtifacts = dtrDeps;
          cargoTestExtraArgs = "--workspace";
          # Flat on purpose: a list inside nativeBuildInputs is a deprecation
          # warning in nixpkgs 26.05, and `nix flake check` prints it.
          # coreutils is for the pty tests, which run `true`; a build's PATH
          # does not otherwise promise it.
          nativeBuildInputs =
            cargoCommon.nativeBuildInputs ++ [pkgs.mesa pkgs.coreutils] ++ fontPackages;
          FONTCONFIG_FILE = fontsConf;
          VK_DRIVER_FILES = "${pkgs.mesa}/share/vulkan/icd.d/lvp_icd.x86_64.json";
          WGPU_BACKEND = "vulkan";
          LIBGL_ALWAYS_SOFTWARE = "1";
          # winit and wgpu reach their backends with `dlopen`, so there is no
          # DT_NEEDED entry and no rpath for the loader to find — the devShell
          # exports this for `cargo run`, and a check has no shellHook. Without
          # it wgpu finds no Vulkan loader and every kittest says "No adapter
          # found", which reads like a missing GPU rather than a missing path.
          LD_LIBRARY_PATH = pkgs.lib.makeLibraryPath (with pkgs; [
            wayland
            libxkbcommon
            vulkan-loader
            libGL
            mesa
            libX11
            libxcb
            libXcursor
            libXi
            libXrandr
            udev
            fontconfig
            freetype
          ]);
          # A panicking test says only "test failed" otherwise, and a backtrace
          # in the check log is the whole reason CI set this before.
          RUST_BACKTRACE = "1";
        });

      # The benchmark payloads are shell scripts, and nothing compiles them: a
      # payload that stopped printing, or a syntax error in one, is invisible to
      # both `cargo test` and the release build. `bench.sh --check` runs each of
      # them under a pty and asserts it still produces bytes, with no window, no
      # GPU and no network — which is what a sandbox is.
      bench-payloads = pkgs.runCommand "dtr-bench-payloads" {
        nativeBuildInputs = with pkgs; [bash coreutils util-linux procps];
      } ''
        # The script finds the payloads relative to itself, so keep the two
        # directories side by side; the store copies are read-only.
        cp -r ${./scripts} scripts
        cp -r ${./benchmarks} benchmarks
        chmod -R u+w scripts benchmarks
        # Through bash, not the shebang: the script asks for `/usr/bin/env`,
        # which a sandbox does not have (the devShell runner's alpine does).
        bash ./scripts/bench.sh --check
        touch $out
      '';

      # `cargo fmt --check` is a layout gate rather than a build: rustfmt reads
      # the sources and writes nothing, so it needs neither the linker, libudev
      # nor the VT core — only the files, and seconds instead of a build. It
      # uses the toolchain's own rustfmt, the one the devShell hands you, so a
      # local `cargo fmt` and this check cannot disagree about what formatted
      # means.
      #
      # Before this existed the tree had never been formatted (`just fmt` was
      # the only way to find out, and it rewrites two thousand lines in the
      # middle of whatever you were doing), so the first run of it was a commit
      # of 54 files with no behaviour in them.
      fmt = craneLib.cargoFmt {
        inherit src version;
        pname = "dtr-fmt";
        # The whole workspace. `cargo fmt` on its own formats the root package,
        # and this is a virtual workspace: it has no root package, so a bare
        # `cargo fmt` would check nothing and always pass.
        cargoExtraArgs = "--all";
      };

      # `just --fmt` rewrites the file in place, and a task list that nobody
      # formats is a diff waiting to happen in every later commit. `just fmt`
      # formats the Rust sources and this file together; `fmt` above is the
      # Rust half, and this is the file half.
      just-fmt = pkgs.runCommand "dtr-just-fmt" {
        nativeBuildInputs = [pkgs.just];
      } ''
        cp ${./justfile} justfile
        just --fmt --check
        touch $out
      '';

      # Every crate the binary links has to be one we can redistribute, and it
      # has to come from a source we chose. The advisory half needs the live
      # RustSec database, so it runs in CI (and `just deny`) rather than here —
      # the checks crane runs are the ones that can be answered offline.
      deny = craneLib.cargoDeny (cargoCommon
        // {
          cargoDenyChecks = "bans licenses sources";
          # Deliberately not in `src`: the policy changes more often than the
          # crates do, and putting it in the source tree would rebuild the
          # binary, the suite and the exe for a comment in the allowlist.
          postPatch = ''
            cp ${./deny.toml} deny.toml
          '';
        });

      # A desktop entry is only worth installing if it parses *and* the icon it
      # names exists: a typo in `Icon=` is a blank square in every menu, and a
      # `StartupWMClass` that disagrees with the window is a second, iconless
      # entry in the dock. The package is the thing checked, not the source file,
      # so a wrong install path fails here too.
      desktop-entry = pkgs.runCommand "dtr-desktop-entry" {
        nativeBuildInputs = [pkgs.desktop-file-utils pkgs.gnused];
      } ''
        entry=${dtr}/share/applications/dtr.desktop
        desktop-file-validate "$entry"

        icon=$(sed -n 's/^Icon=//p' "$entry")
        test -n "$icon" || {
          echo "the desktop entry names no icon" >&2
          exit 1
        }
        for size in scalable 512x512 32x32 16x16; do
          ls ${dtr}/share/icons/hicolor/"$size"/apps/"$icon".* >/dev/null || {
            echo "Icon=$icon has no $size artwork" >&2
            exit 1
          }
        done
        touch $out
      '';

      single-exe = pkgs.runCommand "dtr-single-exe" {
        nativeBuildInputs = [pkgs.binutils];
      } ''
      # Every one of these ships with Windows. The list grows when a dependency
      # reaches a new subsystem: serialport pulls cfgmgr32/combase/rpcrt4 for
      # device enumeration, portable-pty pulls oleaut32/shlwapi, and wgpu's GL
      # fallback pulls opengl32. A new entry here is worth a look, not a shrug.
      allowed='^(api-ms-win-.*|kernel32|user32|gdi32|advapi32|ole32|oleaut32|shell32|shlwapi|dwrite|d2d1|dxgi|d3d12|d3dcompiler_47|setupapi|cfgmgr32|combase|rpcrt4|opengl32|ws2_32|bcrypt|bcryptprimitives|ntdll|msvcrt|userenv|uxtheme|dwmapi|imm32|comctl32|propsys|shcore)\.dll$'
      bad=$(objdump -p ${dtr-windows}/bin/dtr.exe \
        | awk '/DLL Name/ {print tolower($3)}' | sort -u | grep -vE "$allowed" || true)
      if [ -n "$bad" ]; then
        echo "unexpected DLL imports (breaks the single-executable property):" >&2
        echo "$bad" >&2
        exit 1
      fi
        touch $out
      '';
    };

    devShells.${system}.default = pkgs.mkShell {
      packages = [
        rustWindows
        pkgs.cargo-zigbuild
        pkgs.zig_0_17
        pkgs.pkg-config
        pkgs.udev
        pkgs.fontconfig
        pkgs.freetype
        pkgs.socat
        pkgs.just
        # Sampling tools: `perf` for `cargo flamegraph`, and the wrapper that
        # drives it. The in-process fallback (`--cpu-profile`) needs neither.
        pkgs.perf
        pkgs.cargo-flamegraph
        # Supply-chain checks. `checks.deny` runs the offline half in a sandbox;
        # the advisory half needs the RustSec database, so `just deny` and CI
        # run it here, where there is a network.
        pkgs.cargo-deny
        # What a headless machine lacks and a desktop already has: a Vulkan
        # implementation that is not a GPU, and fonts for fontconfig to find.
        # The UI tests render through wgpu and lay out real text, so without
        # these a runner fails nine of them with "No adapter found" and a
        # smaller set with an empty grid face.
        pkgs.mesa
      ]
      # Appended rather than nested: mkShell turns `packages` into
      # nativeBuildInputs, and a list inside one is a nixpkgs 26.05 deprecation
      # warning that `nix flake check` prints.
      ++ fontPackages;

      shellHook = ''
        export PKG_CONFIG_PATH="${libghostty-vt.dev}/share/pkgconfig:${pkgs.udev.dev}/lib/pkgconfig''${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

        # fontconfig reads the store, not /usr/share/fonts, and its compiled-in
        # defaults point at a system a devShell does not have.
        export FONTCONFIG_FILE=${fontsConf}

        # A runner has no /dev/dri, so wgpu enumerates no adapter and every
        # snapshot test panics before it compares anything. Lavapipe is Vulkan in
        # software; selecting it only when there is no DRM node leaves a
        # developer's machine on its GPU, which is also the rasteriser the
        # baselines were made with. The same trick `--screenshot` documents.
        if [ ! -e /dev/dri ]; then
          VK_DRIVER_FILES="$(ls ${pkgs.mesa}/share/vulkan/icd.d/*lvp*.json 2>/dev/null | head -n1)"
          if [ -n "$VK_DRIVER_FILES" ]; then
            export VK_DRIVER_FILES
            export WGPU_BACKEND=vulkan
            export LIBGL_ALWAYS_SOFTWARE=1
            echo "dtr: no /dev/dri, rendering through lavapipe ($VK_DRIVER_FILES)" >&2
          else
            echo "dtr: no /dev/dri and no lavapipe ICD; snapshot tests will find no adapter" >&2
          fi
        fi
      '';

      # winit resolves these with dlopen; make them visible to `cargo run`.
      LD_LIBRARY_PATH = pkgs.lib.makeLibraryPath (with pkgs; [
        wayland
        libxkbcommon
        vulkan-loader
        libGL
        libX11
        libxcb
        libXcursor
        libXi
        libXrandr
        udev
        fontconfig
      ]);
    };
  };
}
