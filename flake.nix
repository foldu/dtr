{
  description = "dtr — a serial-first terminal";

  inputs.nixpkgs.url = "https://channels.nixos.org/nixos-unstable/nixexprs.tar.zst";
  inputs.rust-overlay = {
    url = "github:oxalica/rust-overlay";
    inputs.nixpkgs.follows = "nixpkgs";
  };
  # crane splits the build in two: dependencies compile once into
  # `cargoArtifacts`, and a source-only change recompiles just our crates.
  # With buildRustPackage every edit rebuilt the whole dependency graph, which
  # is minutes of waiting per keystroke-sized change.
  inputs.crane.url = "github:ipetkov/crane";

  outputs = {
    self,
    nixpkgs,
    rust-overlay,
    crane,
  }: let
    system = "x86_64-linux";
    pkgs = import nixpkgs {
      inherit system;
      overlays = [rust-overlay.overlays.default];
    };
    inherit (pkgs) lib;

    # The commit libghostty-vt-sys 0.2.2's bindings were generated against.
    # Do not float: the generated FFI is ABI-specific to this revision.
    ghostty = pkgs.fetchFromGitHub {
      owner = "ghostty-org";
      repo = "ghostty";
      rev = "521cf2c5d30bd48028ca61546c64e7913764073d";
      hash = "sha256-TKWQK2zmv1zwoUasT9ESAZX3xulgmVX5AvGj0hBS7NI=";
    };

    # Upstream's own derivation: builds via `zig build -Demit-lib-vt=true`
    # with an offline package cache generated by zon2nix.
    libghostty-vt = pkgs.callPackage (ghostty + "/nix/libghostty-vt.nix") {
      revision = "521cf2c";
    };

    # Windows: zig names the archive `ghostty-vt-static.lib` and the generated
    # .pc points at $out, so keep everything in one output and skip upstream's
    # move-to-dev steps (they assume an ELF `libghostty-vt.a`).
    libghostty-vt-win = libghostty-vt.overrideAttrs (old: {
      pname = "libghostty-vt-win";
      outputs = ["out"];
      zigBuildFlags = old.zigBuildFlags ++ ["-Dtarget=x86_64-windows-gnu"];
      postInstall = "";
      postFixup = "";
    });

    # Only source files; keeps target/ and results out of the store.
    src = lib.fileset.toSource {
      root = ./.;
      fileset = lib.fileset.unions [
        ./Cargo.toml
        ./Cargo.lock
        ./crates
      ];
    };

    rustHost = pkgs.rust-bin.stable.latest.default;
    craneLib = (crane.mkLib pkgs).overrideToolchain rustHost;

    # Everything the two halves of the build agree on. `cargoArtifacts` is
    # keyed on the *dependencies*, so editing `crates/dtr` reuses the compiled
    # graph and only recompiles the crates that changed.
    cargoCommon = {
      inherit src;
      pname = "dtr";
      version = "0.1.0";
      strictDeps = true;
      buildInputs = [
        pkgs.udev
        pkgs.fontconfig
        pkgs.freetype
        libghostty-vt.dev
        pkgs.vulkan-loader
        pkgs.libxkbcommon
        pkgs.wayland
        pkgs.libX11
        pkgs.libxcb
        pkgs.libXcursor
        pkgs.libXi
        pkgs.libXrandr
      ];
      nativeBuildInputs = [pkgs.pkg-config pkgs.makeWrapper];
      # serialport enumerates through libudev, whose .pc lives in its dev output.
      PKG_CONFIG_PATH = lib.makeSearchPath "share/pkgconfig" [libghostty-vt.dev]
        + ":" + lib.makeSearchPath "lib/pkgconfig" [pkgs.udev.dev pkgs.fontconfig.dev pkgs.freetype.dev];
      # Vendored once, shared by the dependency build and the package build.
      # crane fetches the git dependency at the revision Cargo.lock pins; that
      # revision, not a store hash, is what makes it reproducible here — crane
      # keys output hashes by lock source, so importCargoLock's crate-keyed
      # verification cannot be reused with it.
      cargoVendorDir = craneLib.vendorCargoDeps {
        inherit src;
      };
    };

    # Built once per dependency set; this is the half that used to run on every
    # edit. `cargoArtifacts` is a plain derivation, so it caches in the store and
    # in the binary cache like anything else.
    dtrDeps = craneLib.buildDepsOnly (cargoCommon // {pname = "dtr-deps";});

    dtr = craneLib.buildPackage (cargoCommon
      // {
        cargoArtifacts = dtrDeps;
        # Tests are their own check: `nix build .#dtr` is what you run twenty
        # times an hour, and it should not wait for the whole suite.
        doCheck = false;

        # winit and wgpu-hal resolve these with dlopen, so they never appear as
        # DT_NEEDED entries and no rpath can reach them. A wrapper is the only
        # thing that works for dlopened libraries.
        postInstall = ''
          mv $out/bin/dtr $out/bin/.dtr-unwrapped
          makeWrapper $out/bin/.dtr-unwrapped $out/bin/dtr \
            --prefix LD_LIBRARY_PATH : ${lib.makeLibraryPath (with pkgs; [
          wayland
          libxkbcommon
          vulkan-loader
          libGL
          libX11
          libxcb
          libXcursor
          libXi
          libXrandr
        ])} \
            --suffix LD_LIBRARY_PATH : /run/opengl-driver/lib
        '';
      });

    dtr-windows = pkgs.stdenv.mkDerivation {
      pname = "dtr";
      version = "0.1.0";
      src = src;
      cargoDeps = pkgs.rustPlatform.importCargoLock {
        lockFile = ./Cargo.lock;
        # Git dependencies need explicit hashes; both crates come from the same
        # checkout, so they share one. Update on wrapper bumps.
        outputHashes = {
          "libghostty-vt-0.2.1" = "sha256-Zojd1ziCw9+tbhmGYaFHFPlaxgbNbtmVBR99Otmg+o0=";
          "libghostty-vt-sys-0.2.1" = "sha256-Zojd1ziCw9+tbhmGYaFHFPlaxgbNbtmVBR99Otmg+o0=";
        };
      };
      nativeBuildInputs = [
        rustWindows
        pkgs.cargo-zigbuild
        pkgs.zig_0_17
        pkgs.pkg-config
        pkgs.rustPlatform.cargoSetupHook
      ];
      buildPhase = ''
        runHook preBuild
        # PKG_CONFIG_PATH wins over LIBDIR, so it must be cleared or the
        # devShell's Linux .pc silently supplies a Linux search path.
        # cargo-zigbuild caches under $HOME; the sandbox HOME is unwritable.
        export HOME=$TMPDIR
        export PKG_CONFIG_ALLOW_CROSS=1
        export PKG_CONFIG_PATH=""
        export PKG_CONFIG_LIBDIR=${libghostty-vt-win}/share/pkgconfig
        # winapi links the `synchronization` API-set import library, which zig's
        # mingw does not ship. Every symbol it uses is already in kernel32, so an
        # empty archive satisfies the search without changing the link.
        mkdir -p api-stubs
        printf '!<arch>\n' > api-stubs/libsynchronization.a
        # zig cc enables -Werror=date-time for reproducibility, and mimalloc
        # mentions __DATE__ in an assert message. Its build script suppresses
        # that warning only for non-Windows targets (it assumes MSVC there, where
        # the flag does not exist). Appending the opposite last is what works.
        export CFLAGS_x86_64_pc_windows_gnu="-Wno-error=date-time"
        export RUSTFLAGS="-Lnative=$PWD/api-stubs"
        cargo zigbuild --offline --locked --release --package dtr \
          --target x86_64-pc-windows-gnu
        runHook postBuild
      '';
      installPhase = ''
        runHook preInstall
        install -Dm755 target/x86_64-pc-windows-gnu/release/dtr.exe "$out/bin/dtr.exe"
        runHook postInstall
      '';
    };

    rustWindows = pkgs.rust-bin.stable.latest.default.override {
      targets = ["x86_64-pc-windows-gnu"];
    };
  in {
    packages.${system} = {
      inherit dtr libghostty-vt libghostty-vt-win;
      windows = dtr-windows;
      default = dtr;
    };

    checks.${system} = {
      tests = craneLib.cargoTest (cargoCommon
        // {
          cargoArtifacts = dtrDeps;
          cargoTestExtraArgs = "--workspace";
        });

      single-exe = pkgs.runCommand "dtr-single-exe" {
        nativeBuildInputs = [pkgs.binutils];
      } ''
      # Every one of these ships with Windows. The list grows when a dependency
      # reaches a new subsystem: serialport pulls cfgmgr32/combase/rpcrt4 for
      # device enumeration, portable-pty pulls oleaut32/shlwapi, and wgpu's GL
      # fallback pulls opengl32. A new entry here is worth a look, not a shrug.
      allowed='^(api-ms-win-.*|kernel32|user32|gdi32|advapi32|ole32|oleaut32|shell32|shlwapi|dwrite|d2d1|dxgi|d3d12|d3dcompiler_47|setupapi|cfgmgr32|combase|rpcrt4|opengl32|ws2_32|bcrypt|bcryptprimitives|ntdll|msvcrt|userenv|uxtheme|dwmapi|imm32|comctl32|propsys|shcore)\.dll$'
      bad=$(objdump -p ${dtr-windows}/bin/dtr.exe \
        | awk '/DLL Name/ {print tolower($3)}' | sort -u | grep -vE "$allowed" || true)
      if [ -n "$bad" ]; then
        echo "unexpected DLL imports (breaks the single-executable property):" >&2
        echo "$bad" >&2
        exit 1
      fi
        touch $out
      '';
    };

    devShells.${system}.default = pkgs.mkShell {
      packages = [
        rustWindows
        pkgs.cargo-zigbuild
        pkgs.zig_0_17
        pkgs.pkg-config
        pkgs.udev
        pkgs.fontconfig
        pkgs.freetype
        pkgs.socat
        pkgs.just
      ];

      shellHook = ''
        export PKG_CONFIG_PATH="${libghostty-vt.dev}/share/pkgconfig:${pkgs.udev.dev}/lib/pkgconfig''${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
      '';

      # winit resolves these with dlopen; make them visible to `cargo run`.
      LD_LIBRARY_PATH = pkgs.lib.makeLibraryPath (with pkgs; [
        wayland
        libxkbcommon
        vulkan-loader
        libGL
        libX11
        libxcb
        libXcursor
        libXi
        libXrandr
        udev
        fontconfig
      ]);
    };
  };
}
