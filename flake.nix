{
  description = "dtr — a serial-first terminal";

  inputs.nixpkgs.url = "https://channels.nixos.org/nixos-unstable/nixexprs.tar.zst";
  inputs.rust-overlay = {
    url = "github:oxalica/rust-overlay";
    inputs.nixpkgs.follows = "nixpkgs";
  };

  outputs = {
    self,
    nixpkgs,
    rust-overlay,
  }: let
    system = "x86_64-linux";
    pkgs = import nixpkgs {
      inherit system;
      overlays = [rust-overlay.overlays.default];
    };
    inherit (pkgs) lib;

    # The commit libghostty-vt-sys 0.2.2's bindings were generated against.
    # Do not float: the generated FFI is ABI-specific to this revision.
    ghostty = pkgs.fetchFromGitHub {
      owner = "ghostty-org";
      repo = "ghostty";
      rev = "521cf2c5d30bd48028ca61546c64e7913764073d";
      hash = "sha256-TKWQK2zmv1zwoUasT9ESAZX3xulgmVX5AvGj0hBS7NI=";
    };

    # Upstream's own derivation: builds via `zig build -Demit-lib-vt=true`
    # with an offline package cache generated by zon2nix.
    libghostty-vt = pkgs.callPackage (ghostty + "/nix/libghostty-vt.nix") {
      revision = "521cf2c";
    };

    # Windows: zig names the archive `ghostty-vt-static.lib` and the generated
    # .pc points at $out, so keep everything in one output and skip upstream's
    # move-to-dev steps (they assume an ELF `libghostty-vt.a`).
    libghostty-vt-win = libghostty-vt.overrideAttrs (old: {
      pname = "libghostty-vt-win";
      outputs = ["out"];
      zigBuildFlags = old.zigBuildFlags ++ ["-Dtarget=x86_64-windows-gnu"];
      postInstall = "";
      postFixup = "";
    });

    # Only source files; keeps target/ and results out of the store.
    src = lib.fileset.toSource {
      root = ./.;
      fileset = lib.fileset.unions [
        ./Cargo.toml
        ./Cargo.lock
        ./crates
      ];
    };

    dtr = pkgs.rustPlatform.buildRustPackage {
      pname = "dtr";
      version = "0.1.0";
      src = src;
      buildAndTestSubdir = "crates/dtr";
      # Git dependencies need explicit output hashes; both crates come from
      # the same checkout, so they share one. Update on wrapper bumps.
      cargoLock = {
        lockFile = ./Cargo.lock;
        outputHashes = {
          "libghostty-vt-0.2.1" = "sha256-Zojd1ziCw9+tbhmGYaFHFPlaxgbNbtmVBR99Otmg+o0=";
          "libghostty-vt-sys-0.2.1" = "sha256-Zojd1ziCw9+tbhmGYaFHFPlaxgbNbtmVBR99Otmg+o0=";
        };
      };
      buildInputs = [
        libghostty-vt.dev
        pkgs.vulkan-loader
        pkgs.libxkbcommon
        pkgs.wayland
        pkgs.libX11
        pkgs.libxcb
        pkgs.libXcursor
        pkgs.libXi
        pkgs.libXrandr
      ];
      preBuild = ''
        export PKG_CONFIG_PATH=${libghostty-vt.dev}/share/pkgconfig
      '';
      nativeBuildInputs = [pkgs.pkg-config pkgs.makeWrapper];

      # winit and wgpu-hal resolve these with dlopen, so they never appear as
      # DT_NEEDED entries and no rpath can reach them. A wrapper is the only
      # thing that works for dlopened libraries.
      postInstall = ''
        mv $out/bin/dtr $out/bin/.dtr-unwrapped
        makeWrapper $out/bin/.dtr-unwrapped $out/bin/dtr \
          --prefix LD_LIBRARY_PATH : ${lib.makeLibraryPath (with pkgs; [
          wayland
          libxkbcommon
          vulkan-loader
          libGL
          libX11
          libxcb
          libXcursor
          libXi
          libXrandr
        ])} \
          --suffix LD_LIBRARY_PATH : /run/opengl-driver/lib
      '';
    };

    dtr-windows = pkgs.stdenv.mkDerivation {
      pname = "dtr";
      version = "0.1.0";
      src = src;
      cargoDeps = pkgs.rustPlatform.importCargoLock {
        lockFile = ./Cargo.lock;
        outputHashes = {
          "libghostty-vt-0.2.1" = "sha256-Zojd1ziCw9+tbhmGYaFHFPlaxgbNbtmVBR99Otmg+o0=";
          "libghostty-vt-sys-0.2.1" = "sha256-Zojd1ziCw9+tbhmGYaFHFPlaxgbNbtmVBR99Otmg+o0=";
        };
      };
      nativeBuildInputs = [
        rustWindows
        pkgs.cargo-zigbuild
        pkgs.zig_0_17
        pkgs.pkg-config
        pkgs.rustPlatform.cargoSetupHook
      ];
      buildPhase = ''
        runHook preBuild
        # PKG_CONFIG_PATH wins over LIBDIR, so it must be cleared or the
        # devShell's Linux .pc silently supplies a Linux search path.
        # cargo-zigbuild caches under $HOME; the sandbox HOME is unwritable.
        export HOME=$TMPDIR
        export PKG_CONFIG_ALLOW_CROSS=1
        export PKG_CONFIG_PATH=""
        export PKG_CONFIG_LIBDIR=${libghostty-vt-win}/share/pkgconfig
        # winapi links the `synchronization` API-set import library, which zig's
        # mingw does not ship. Every symbol it uses is already in kernel32, so an
        # empty archive satisfies the search without changing the link.
        mkdir -p api-stubs
        printf '!<arch>\n' > api-stubs/libsynchronization.a
        export RUSTFLAGS="-Lnative=$PWD/api-stubs"
        cargo zigbuild --offline --locked --release --package dtr \
          --target x86_64-pc-windows-gnu
        runHook postBuild
      '';
      installPhase = ''
        runHook preInstall
        install -Dm755 target/x86_64-pc-windows-gnu/release/dtr.exe "$out/bin/dtr.exe"
        runHook postInstall
      '';
    };

    rustWindows = pkgs.rust-bin.stable.latest.default.override {
      targets = ["x86_64-pc-windows-gnu"];
    };
  in {
    packages.${system} = {
      inherit dtr libghostty-vt libghostty-vt-win;
      windows = dtr-windows;
      default = dtr;
    };

    checks.${system}.single-exe = pkgs.runCommand "dtr-single-exe" {
      nativeBuildInputs = [pkgs.binutils];
    } ''
      allowed='^(api-ms-win-.*|kernel32|user32|gdi32|advapi32|ole32|shell32|dxgi|d3d12|d3dcompiler_47|setupapi|ws2_32|bcrypt|bcryptprimitives|ntdll|msvcrt|userenv|uxtheme|dwmapi|imm32|comctl32|propsys|shcore)\.dll$'
      bad=$(objdump -p ${dtr-windows}/bin/dtr.exe \
        | awk '/DLL Name/ {print tolower($3)}' | sort -u | grep -vE "$allowed" || true)
      if [ -n "$bad" ]; then
        echo "unexpected DLL imports (breaks the single-executable property):" >&2
        echo "$bad" >&2
        exit 1
      fi
      touch $out
    '';

    devShells.${system}.default = pkgs.mkShell {
      packages = [
        rustWindows
        pkgs.cargo-zigbuild
        pkgs.zig_0_17
        pkgs.pkg-config
        pkgs.socat
        pkgs.just
      ];

      shellHook = ''
        export PKG_CONFIG_PATH="${libghostty-vt.dev}/share/pkgconfig''${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
      '';

      # winit resolves these with dlopen; make them visible to `cargo run`.
      LD_LIBRARY_PATH = pkgs.lib.makeLibraryPath (with pkgs; [
        wayland
        libxkbcommon
        vulkan-loader
        libGL
        libX11
        libxcb
        libXcursor
        libXi
        libXrandr
      ]);
    };
  };
}
